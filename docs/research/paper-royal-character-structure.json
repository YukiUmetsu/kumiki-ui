  "attachment_rules": {
    "root_motion": "All visible character parts share the parent root's rigid world transform while retaining their own hinge pivot",
    "joint_overlaps": "Keep artist-authored hidden overlaps beneath neck, sleeves, wing base and tail root; keep opaque material color",
    "bounded_axes": "No unbounded affine translation, no alpha crossfades, no unconnected appendages",
    "known_limits": "2.5D cut-paper profile with rigid hinge animation, not full IK, realistic perspective, six-angle human character model, or lip-synced dialogue"
  },
  "camera": {
    "presets": [
      "forest establishing",
      "fox guides",
      "lantern restoration"
    ],
    "zoom_range": [
      1.02,
      1.05
    ],
    "cadence": "deliberate hold, soft pan, hold"
  },
  "deliverables": [
    "Storybook single page",
    "FilmStage 2-aspect example film",
    "three-act per-region stills",
    "animated 30 frame edit clip",
    "tests and visual critique log"
  ]
}
