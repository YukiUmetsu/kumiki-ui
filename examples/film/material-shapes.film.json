          "width": 3200,
          "height": 1936
        }
      }
    },
    {
      "id": "close",
      "recipeId": "card",
      "durationFrames": 138,
      "transition": {
        "kind": "shape",
        "shape": "circle",
        "material": "frost",
        "durationFrames": 50
